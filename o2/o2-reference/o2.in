&CONTROL
    calculation = 'relax'
    prefix      = 'o2_ref'
    outdir      = './tmp/'
    pseudo_dir = '/home/nour/o2-reference/'
    forc_conv_thr = 1.0d-4
/
&SYSTEM
    ibrav        = 1
    celldm(1)    = 22.67       ! boite cubique ~12 Ang (vacuum)
    nat          = 2
    ntyp         = 1
    ecutwfc      = 40.0
    ecutrho      = 320.0
    nspin        = 2           ! OBLIGATOIRE pour O2 (triplet)
    tot_magnetization = 2      ! 2 electrons non apparies
/
&ELECTRONS
    conv_thr   = 1.0d-8
    mixing_beta = 0.7
/
&IONS
    ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
 O  16.00  O.UPF

ATOMIC_POSITIONS (angstrom)
O   6.00000   6.00000   6.00000
O   7.21000   6.00000   6.00000   ! distance initiale ~1.21 Ang

K_POINTS (gamma)

